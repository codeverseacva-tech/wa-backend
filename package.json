{
  "name": "zaplink-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for WhatsApp SaaS platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "lint": "eslint 'src/**/*.ts' --fix",
    "test": "vitest",
    "test:unit": "vitest run --config src/tests/unit/vitest.config.ts",
    "test:unit:watch": "vitest --config src/tests/unit/vitest.config.ts",
    "test:integration": "vitest run --config src/tests/integration/vitest.config.ts",
    "test:integration:watch": "vitest --config src/tests/integration/vitest.config.ts",
    "validate:openapi": "redocly lint openapi.yaml",
    "db:migrate": "supabase migration up"
  },
  "dependencies": {
    "@bull-board/api": "^5.14.0",
    "@bull-board/express": "^5.14.0",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/auto-instrumentations-node": "^0.41.0",
    "@opentelemetry/sdk-node": "^0.46.0",
    "@supabase/supabase-js": "^2.39.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "axios": "^1.14.0",
    "bullmq": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^5.0.0-beta.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "ipaddr.js": "^2.3.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "libsignal-node": "^2.0.1",
    "multer": "^2.1.1",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@redocly/cli": "^2.25.2",
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.16",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  }
}
