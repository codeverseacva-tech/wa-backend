NODE_ENV=production
REHYDRATE_SESSIONS=true
PORT=3000
API_BASE_URL=https://api.yourdomain.com
API_VERSION=v1
FRONTEND_URL=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

REDIS_URL=redis://redis:6379

SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_ANON_KEY=your-prod-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key
SUPABASE_JWT_SECRET=your-prod-jwt-secret

LOG_LEVEL=info
METRICS_PORT=9090
IS_DOCS_PUBLIC=false

JWT_SECRET=your-jwt-secret
METRICS_SECRET=your-metrics-secret

TUMA_EMAIL=your-email
TUMA_API_KEY=your-api-key
TUMA_CALLBACK_URL=https://api.yourdomain.com/v1/billing/tuma/callback

SLACK_WEBHOOK_URL=your-slack-webhook
