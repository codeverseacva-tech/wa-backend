# API Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
API_VERSION=v1
FRONTEND_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000

# Database (zaplink-dev project)
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key
SUPABASE_JWT_SECRET=your-dev-jwt-secret
DATABASE_URL=postgresql://postgres.devproject:password@aws-0-xx.pooler.supabase.com:6543/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# Logging & Monitoring
LOG_LEVEL=debug
SLACK_WEBHOOK_URL=your-dev-slack-webhook
METRICS_PORT=9090
METRICS_SECRET=your-dev-metrics-secret

# Session Management
REHYDRATE_SESSIONS=false

# Auth
JWT_SECRET=your-dev-jwt-secret
JWT_EXPIRY=7d

# Third Party (Tuma M-Pesa Sandbox)
TUMA_EMAIL=your-email
TUMA_API_KEY=your-api-key
TUMA_CALLBACK_URL=http://localhost:3000/v1/billing/tuma/callback
