# API Configuration
NODE_ENV=production
PORT=3000
API_BASE_URL=https://api.yourdomain.com
API_VERSION=v1
FRONTEND_URL=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# Database & Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:password@aws-0-xx.pooler.supabase.com:6543/postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Logging & Monitoring
LOG_LEVEL=info
SLACK_WEBHOOK_URL=your-slack-webhook
METRICS_PORT=9090
METRICS_SECRET=your-metrics-secret

# Session Management
REHYDRATE_SESSIONS=true

# Auth
JWT_SECRET=your-jwt-secret
JWT_EXPIRY=7d

# Third Party
TUMA_EMAIL=your-email
TUMA_API_KEY=your-api-key
TUMA_CALLBACK_URL=https://api.yourdomain.com/v1/billing/tuma/callback
